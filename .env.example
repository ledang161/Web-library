DB_HOST=localhost
DB_PORT=3306
DB_USER=uniborrow_app
DB_PASSWORD=replace-with-your-local-password
DB_NAME=uniborrow
PORT=3000
NODE_ENV=development
# Origin chính xác, không có dấu / cuối. Đổi cùng PORT nếu dùng cổng khác.
APP_ORIGIN=http://localhost:3000
# Chỉ bật sau reverse proxy HTTPS tin cậy khi triển khai production.
TRUST_PROXY=false
